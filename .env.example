# Optional backend for cloud-only features. Local projects and user-provided AI
# connections do not need it.
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1
VITE_API_TARGET=http://127.0.0.1:8080
VITE_STUDIO_HOST=127.0.0.1
VITE_STUDIO_PORT=5173

# Electron reads this at runtime. Never put an API key in this file.
AI_DRAMA_STUDIO_API_ORIGIN=http://127.0.0.1:8080
AI_DRAMA_STUDIO_DEV_URL=http://127.0.0.1:5173
